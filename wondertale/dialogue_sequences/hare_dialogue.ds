{
  "title": "starting",
  "nodes": [
    {
      "id": "node:1",
      "type": "DIALOGUE",
      "position": "(-700.0, 400.0)",
      "character": "uid://dkyuypgp4wyd5::hare",
      "text": "Why Helllllllooooo there Alice!",
      "text_translation_key": ""
    },
    {
      "id": "node:2",
      "type": "START",
      "position": "(-1300.0, 400.0)"
    },
    {
      "id": "node:3",
      "type": "DIALOGUE",
      "position": "(-160.0, 420.0)",
      "character": "uid://dkyuypgp4wyd5::Alice",
      "text": "\"Alice\"? How do you know my name? Where am I?",
      "text_translation_key": ""
    },
    {
      "id": "node:4",
      "type": "DIALOGUE",
      "position": "(320.0, 420.0)",
      "character": "uid://dkyuypgp4wyd5::hare",
      "text": "Why you're in WONDERLAND of course!",
      "text_translation_key": ""
    },
    {
      "id": "node:5",
      "type": "DIALOGUE",
      "position": "(-700.0, 1080.0)",
      "character": "uid://dkyuypgp4wyd5::Alice",
      "text": "\"Wonderland\"?",
      "text_translation_key": ""
    },
    {
      "id": "node:6",
      "type": "DIALOGUE",
      "position": "(-120.0, 1100.0)",
      "character": "uid://dkyuypgp4wyd5::hare",
      "text": "Yes, Wonderland! Say, you appear lost. Do you need assistance?",
      "text_translation_key": ""
    },
    {
      "id": "node:7",
      "type": "DIALOGUE",
      "position": "(480.0, 1100.0)",
      "character": "uid://dkyuypgp4wyd5::Alice",
      "text": "Yes! How do I get back home?",
      "text_translation_key": ""
    },
    {
      "id": "node:8",
      "type": "DIALOGUE",
      "position": "(-660.0, 1600.0)",
      "character": "uid://dkyuypgp4wyd5::hare",
      "text": "Why, keep following the trail as you have now, and you'll find my home. There we can begin to look for a way for you to return home! Farewell!",
      "text_translation_key": ""
    },
    {
      "id": "node:9",
      "type": "END",
      "position": "(-140.0, 1720.0)"
    }
  ],
